# Required for /api/draft-message — Live AI draft generation in the Performance AI Inbox.
# Get a key from https://console.anthropic.com/.
#
# Local dev: copy this file to `.env.local` and fill in the key.
#   (Note: /api routes only run under `vercel dev`, not plain `vite`.)
# Production: set ANTHROPIC_API_KEY in Vercel project settings → Environment Variables.
ANTHROPIC_API_KEY=

# Demo-token gate for write/model API routes (see api/_lib/auth.ts).
# - DEMO_TOKEN is the server-side expected value (any opaque string).
# - VITE_DEMO_TOKEN is what the client sends in the X-Demo-Token header.
# Both must be set, and they must match. The public token value is documented
# in the README live-demo callout so genuine demo visitors can use it; bots
# and scrapers without the header are rejected with 401.
DEMO_TOKEN=
VITE_DEMO_TOKEN=

# Optional — per-IP rate limit on /api/draft-message uses Upstash Redis REST
# when these are set, and falls back to per-instance in-memory counters
# otherwise. Get free credentials at https://upstash.com/.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
